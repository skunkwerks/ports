diff --git a/examples/iex.exs b/examples/iex.exs
new file mode 100644
index 0000000000..1cdcc12d6e
--- /dev/null
+++ b/examples/iex.exs
@@ -0,0 +1,37 @@
+# The `iex` command; bin/iex starts the VM with `-user elixir`, here the
+# shell is started afterwards with shell:start_interactive/1.
+defmodule IExCommand do
+  def start_node(argv) do
+    case argv do
+      ["--sname", name | rest] -> start_node(:shortnames, name, rest)
+      ["--name", name | rest] -> start_node(:longnames, name, rest)
+      ["--cookie", cookie | rest] -> :erlang.set_cookie(String.to_atom(cookie)); start_node(rest)
+      ["--erl", _ | _] -> raise ArgumentError, "--erl is not supported by this executable"
+      [_ | rest] -> start_node(rest)
+      [] -> :ok
+    end
+  end
+
+  defp start_node(domain, name, rest) do
+    start_epmd()
+    name = if name == "undefined", do: :undefined, else: String.to_atom(name)
+    {:ok, _} = :net_kernel.start(name, %{name_domain: domain})
+    start_node(rest)
+  end
+
+  defp start_epmd do
+    {:ok, [[bindir]]} = :init.get_argument(:bindir)
+    port = Port.open({:spawn_executable, Path.join(bindir, "epmd")}, [:exit_status, args: ["-daemon"]])
+
+    receive do
+      {^port, {:exit_status, 0}} -> :ok
+    end
+  end
+end
+
+IExCommand.start_node(System.argv())
+
+{:iex, :start, [opts, _mfa]} = :iex.shell()
+argv = Enum.map(["--no-halt", "+iex" | System.argv()], &String.to_charlist/1)
+:ok = :shell.start_interactive({:iex, :start, [opts, {Kernel.CLI, :main, [argv]}]})
+System.no_halt(true)
