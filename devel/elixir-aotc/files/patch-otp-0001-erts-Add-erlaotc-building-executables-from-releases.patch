+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ * %CopyrightEnd%
+ */
+/*
+ * Purpose: erlaotc - build an executable from a release: the emulator plus
+ * a zip archive of lib/ and releases/.
+ */
+
+#include "etc_common.h"
+
+#include <dirent.h>
+#include <stdint.h>
+#include <sys/stat.h>
+
+#define EMULATOR "beam.smp"
+#define MAGIC "erlaotc " ERTS_VSN "\n"
+
+static const char *release_dirs[] = {"lib", "releases", NULL};
+
+/* Set here, or handled by erl(1) */
+static const char *rejected_args[] = {
+    "-root", "-bindir", "-progname", "-boot", "-config", "-primary_archive",
+    "-args_file", "-emu_args", "-emu_type", "-emu_flavor", "-env", "-epmd",
+    "-extra", "-heart", "-detached", "-compile", "-make", "-man", "-x",
+    "-version", NULL
+};
+
+typedef struct {
+    char **v;
+    int n;
+    int max;
+} args_t;
+
+typedef struct {
+    char *name;      /* name in the archive */
+    char *path;      /* path in the file system */
+    uint32_t crc;
+    uint32_t size;
+    uint32_t offset; /* of the local file header */
+} entry_t;
+
+static entry_t *entries;
+static int n_entries, max_entries;
+static uint32_t crc_table[256];
+
+static void error(const char *format, ...)
+{
+    va_list args;
+    fprintf(stderr, "erlaotc: ");
+    va_start(args, format);
+    vfprintf(stderr, format, args);
+    va_end(args);
+    fprintf(stderr, "\n");
+    exit(1);
+}
+
+static void usage(void)
+{
+    fprintf(stderr,
+            "Usage: erlaotc [-o Output] ReleaseDir [Arg ...]\n"
+            "\n"
+            "Builds an executable from the release in ReleaseDir. Arg ...\n"
+            "are arguments for erl(1), given in addition to those in\n"
+            "releases/Vsn/vm.args; $ROOT in them refers to the executable.\n");
+    exit(1);
+}
+
+static void *emalloc(size_t size)
+{
+    void *p = malloc(size);
+    if (p == NULL)
+        error("out of memory");
+    return p;
+}
+
+static void *erealloc(void *p, size_t size)
+{
+    p = realloc(p, size);
+    if (p == NULL)
+        error("out of memory");
+    return p;
+}
+
+static char *strsave(const char *s)
+{
+    char *p = emalloc(strlen(s) + 1);
+    strcpy(p, s);
+    return p;
+}
+
+static char *join(const char *a, const char *b)
+{
+    char *p = emalloc(strlen(a) + strlen(b) + 2);
+    sprintf(p, "%s/%s", a, b);
+    return p;
+}
+
+static void args_add(args_t *args, char *arg)
+{
+    if (args->n + 1 >= args->max) {
+        args->max = args->max ? args->max * 2 : 32;
+        args->v = erealloc(args->v, sizeof(char *) * args->max);
+    }
+    args->v[args->n++] = arg;
+    args->v[args->n] = NULL;
+}
+
+/* As -args_file of erl(1) */
+static void read_args_file(const char *path, args_t *args)
+{
+    FILE *f = fopen(path, "r");
+    char *buf = NULL;
+    size_t size = 0, len = 0, n;
+    char *p, *cur;
+    enum { Start, Build, SQuoted, DQuoted, Escape, Comment } state;
+
+    if (f == NULL)
+        error("cannot open %s: %s", path, strerror(errno));
+    do {
+        buf = erealloc(buf, size += 4096);
+        n = fread(buf + len, 1, size - len - 1, f);
+        len += n;
+    } while (n > 0);
+    if (ferror(f))
+        error("cannot read %s: %s", path, strerror(errno));
+    fclose(f);
+    buf[len] = '\0';
+
+    cur = emalloc(len + 1);
+    n = 0;
+    state = Start;
+    for (p = buf; ; p++) {
+        char c = *p;
+        switch (state) {
+        case Start:
+            if (c == '\0')
+                goto done;
+            if (c == '#')
+                state = Comment;
+            else if (!isspace((unsigned char)c)) {
+                p--;
+                state = Build;
+            }
+            break;
+        case Build:
+            if (c == '\0' || c == '#' || isspace((unsigned char)c)) {
+                cur[n] = '\0';
+                args_add(args, strsave(cur));
+                n = 0;
+                state = Start;
+                p--;
+            } else if (c == '"')
+                state = DQuoted;
+            else if (c == '\'')
+                state = SQuoted;
+            else if (c == '\\')
+                state = Escape;
+            else
+                cur[n++] = c;
+            break;
+        case DQuoted:
+        case SQuoted:
+            if (c == '\0')
+                error("%s: unterminated quote", path);
+            if (c == (state == DQuoted ? '"' : '\''))
+                state = Build;
+            else
+                cur[n++] = c;
+            break;
+        case Escape:
+            if (c == '\0')
+                error("%s: unterminated escape", path);
+            cur[n++] = c;
+            state = Build;
+            break;
+        case Comment:
+            if (c == '\0')
+                goto done;
+            if (c == '\n')
+                state = Start;
+            break;
+        }
+    }
+done:
+    free(cur);
+    free(buf);
+}
+
+static int is_flag(const char *arg)
+{
+    return (arg[0] == '-' || arg[0] == '+') && arg[1] != '\0';
+}
+
+/* As erl(1): +Flag and its values go to the emulator, the rest to init */
+static void split_args(args_t *in, args_t *emu, args_t *init)
+{
+    int i, j, emu_flag = 0;
+
+    for (i = 0; i < in->n; i++) {
+        char *arg = in->v[i];
+        if (strchr(arg, '\n') != NULL)
+            error("argument with a newline: %s", arg);
+        for (j = 0; rejected_args[j] != NULL; j++) {
+            if (strcmp(arg, rejected_args[j]) == 0)
+                error("%s cannot be given to an executable", arg);
+        }
+        if (arg[0] == '+' && arg[1] != '\0') {
+            arg[0] = '-';
+            args_add(emu, arg);
+            emu_flag = 1;
+        } else if (emu_flag && !is_flag(arg)) {
+            args_add(emu, arg);
+        } else {
+            args_add(init, arg);
+            emu_flag = 0;
+        }
+    }
+}
+
+static void crc_init(void)
+{
+    uint32_t i, j, c;
+    for (i = 0; i < 256; i++) {
+        c = i;
+        for (j = 0; j < 8; j++)
+            c = (c & 1) ? 0xedb88320u ^ (c >> 1) : c >> 1;
+        crc_table[i] = c;
+    }
+}
+
+static uint32_t crc32_update(uint32_t crc, const unsigned char *p, size_t n)
+{
+    crc = ~crc;
+    while (n-- > 0)
+        crc = crc_table[(crc ^ *p++) & 0xff] ^ (crc >> 8);
+    return ~crc;
+}
+
+static int cmp_names(const void *a, const void *b)
+{
+    return strcmp(*(char *const *)a, *(char *const *)b);
+}
+
+static void collect(const char *dir, const char *name)
+{
+    DIR *d = opendir(dir);
+    struct dirent *ent;
+    char **names = NULL;
+    int n = 0, max = 0, i;
+
+    if (d == NULL)
+        error("cannot read %s: %s", dir, strerror(errno));
+    while ((ent = readdir(d)) != NULL) {
+        if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0)
+            continue;
+        if (n >= max)
+            names = erealloc(names, sizeof(char *) * (max += 64));
+        names[n++] = strsave(ent->d_name);
+    }
+    closedir(d);
+    qsort(names, n, sizeof(char *), cmp_names);
+
+    for (i = 0; i < n; i++) {
+        char *path = join(dir, names[i]);
+        char *ename = join(name, names[i]);
+        struct stat st;
+
+        if (stat(path, &st) != 0)
+            error("cannot stat %s: %s", path, strerror(errno));
+        if (S_ISDIR(st.st_mode)) {
+            collect(path, ename);
+            free(path);
+            free(ename);
+        } else if (S_ISREG(st.st_mode)) {
+            entry_t *e;
+            if (st.st_size > 0xffffffffu)
+                error("%s is too large", path);
+            if (n_entries >= max_entries)
+                entries = erealloc(entries, sizeof(entry_t) *
+                                   (max_entries += 256));
+            e = &entries[n_entries++];
+            e->name = ename;
+            e->path = path;
+            e->size = (uint32_t)st.st_size;
+        } else {
+            error("%s is neither a regular file nor a directory", path);
+        }
+        free(names[i]);
+    }
+    free(names);
+}
+
+static void put16(FILE *f, unsigned v)
+{
+    unsigned char b[2] = {v & 0xff, (v >> 8) & 0xff};
+    fwrite(b, 1, 2, f);
+}
+
+static void put32(FILE *f, uint32_t v)
+{
+    unsigned char b[4] = {v & 0xff, (v >> 8) & 0xff, (v >> 16) & 0xff,
+                          (v >> 24) & 0xff};
+    fwrite(b, 1, 4, f);
+}
+
+static void copy_file(FILE *out, const char *path, uint32_t *crc)
+{
+    FILE *in = fopen(path, "rb");
+    unsigned char buf[65536];
+    size_t n;
+
+    if (in == NULL)
+        error("cannot open %s: %s", path, strerror(errno));
+    *crc = 0;
+    while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {
+        *crc = crc32_update(*crc, buf, n);
+        fwrite(buf, 1, n, out);
+    }
+    if (ferror(in))
+        error("cannot read %s: %s", path, strerror(errno));
+    fclose(in);
+}
+
+/* Uncompressed and with a fixed timestamp, so builds are reproducible */
+#define ZIP_TIME 0
+#define ZIP_DATE 0x21 /* 1980-01-01 */
+
+static void write_executable(const char *out_path, const char *emulator,
+                             args_t *emu_args, args_t *init_args)
+{
+    char *tmp_path = emalloc(strlen(out_path) + 5);
+    FILE *out;
+    long offset;
+    uint32_t cd_offset, cd_size;
+    int i;
+
+    sprintf(tmp_path, "%s.tmp", out_path);
+    out = fopen(tmp_path, "wb");
+    if (out == NULL)
+        error("cannot create %s: %s", tmp_path, strerror(errno));
+
+    {
+        uint32_t crc;
+        copy_file(out, emulator, &crc);
+    }
+
+    for (i = 0; i < n_entries; i++) {
+        entry_t *e = &entries[i];
+        uint32_t crc;
+
+        offset = ftell(out);
+        if (offset < 0 || offset > 0xffffffffL)
+            error("the executable would be too large");
+        e->offset = (uint32_t)offset;
+
+        put32(out, 0x04034b50);
+        put16(out, 20);          /* version needed to extract */
+        put16(out, 0x0800);      /* flags: UTF-8 names */
+        put16(out, 0);           /* method: stored */
+        put16(out, ZIP_TIME);
+        put16(out, ZIP_DATE);
+        put32(out, 0);           /* crc, see below */
+        put32(out, e->size);
+        put32(out, e->size);
+        put16(out, (unsigned)strlen(e->name));
+        put16(out, 0);           /* extra field length */
+        fwrite(e->name, 1, strlen(e->name), out);
+
+        copy_file(out, e->path, &crc);
+        e->crc = crc;
+        offset = ftell(out);
+        if (fseek(out, (long)e->offset + 14, SEEK_SET) != 0)
+            error("cannot write %s: %s", tmp_path, strerror(errno));
+        put32(out, crc);
+        if (fseek(out, offset, SEEK_SET) != 0)
+            error("cannot write %s: %s", tmp_path, strerror(errno));
+    }
+
+    offset = ftell(out);
+    if (offset < 0 || offset > 0xffffffffL)
+        error("the executable would be too large");
+    cd_offset = (uint32_t)offset;
+    for (i = 0; i < n_entries; i++) {
+        entry_t *e = &entries[i];
+        put32(out, 0x02014b50);
+        put16(out, 20);          /* version made by */
+        put16(out, 20);          /* version needed to extract */
+        put16(out, 0x0800);
+        put16(out, 0);
+        put16(out, ZIP_TIME);
+        put16(out, ZIP_DATE);
+        put32(out, e->crc);
+        put32(out, e->size);
+        put32(out, e->size);
+        put16(out, (unsigned)strlen(e->name));
+        put16(out, 0);           /* extra field length */
+        put16(out, 0);           /* file comment length */
+        put16(out, 0);           /* disk number start */
+        put16(out, 0);           /* internal attributes */
+        put32(out, 0);           /* external attributes */
+        put32(out, e->offset);
+        fwrite(e->name, 1, strlen(e->name), out);
+    }
+    offset = ftell(out);
+    if (offset < 0 || offset > 0xffffffffL)
+        error("the executable would be too large");
+    cd_size = (uint32_t)offset - cd_offset;
+
+    {
+        size_t comment_size = strlen(MAGIC);
+        for (i = 0; i < emu_args->n; i++)
+            comment_size += strlen(emu_args->v[i]) + 1;
+        comment_size += 3; /* "--\n" */
+        for (i = 0; i < init_args->n; i++)
+            comment_size += strlen(init_args->v[i]) + 1;
+        if (comment_size > 0xffff)
+            error("the arguments are too long");
+
+        put32(out, 0x06054b50);
+        put16(out, 0);           /* this disk */
+        put16(out, 0);           /* disk with the central directory */
+        put16(out, (unsigned)n_entries);
+        put16(out, (unsigned)n_entries);
+        put32(out, cd_size);
+        put32(out, cd_offset);
+        put16(out, (unsigned)comment_size);
+        fputs(MAGIC, out);
+        for (i = 0; i < emu_args->n; i++)
+            fprintf(out, "%s\n", emu_args->v[i]);
+        fputs("--\n", out);
+        for (i = 0; i < init_args->n; i++)
+            fprintf(out, "%s\n", init_args->v[i]);
+    }
+
+    if (fflush(out) != 0 || ferror(out))
+        error("cannot write %s: %s", tmp_path, strerror(errno));
+    if (fchmod(fileno(out), 0755) != 0)
+        error("cannot chmod %s: %s", tmp_path, strerror(errno));
+    if (fclose(out) != 0)
+        error("cannot write %s: %s", tmp_path, strerror(errno));
+    if (rename(tmp_path, out_path) != 0)
+        error("cannot create %s: %s", out_path, strerror(errno));
+    free(tmp_path);
+}
+
+static char *bindir(const char *argv0)
+{
+    const char *env = getenv("BINDIR");
+    char *dir, *p;
+
+    if (env != NULL && env[0] != '\0')
+        return strsave(env);
+    dir = strsave(argv0);
+    p = strrchr(dir, '/');
+    if (p == NULL)
+        error("BINDIR is not set");
+    *p = '\0';
+    return dir;
+}
+
+static char *release_version(const char *release_dir)
+{
+    char *path = join(release_dir, "releases/start_erl.data");
+    FILE *f = fopen(path, "r");
+    char erts_vsn[64], rel_vsn[256];
+
+    if (f == NULL)
+        error("cannot open %s: %s", path, strerror(errno));
+    if (fscanf(f, "%63s %255s", erts_vsn, rel_vsn) != 2)
+        error("%s: expected \"ErtsVsn RelVsn\"", path);
+    fclose(f);
+    if (strcmp(erts_vsn, ERTS_VSN) != 0)
+        error("the release is for erts %s, this is erts %s", erts_vsn,
+              ERTS_VSN);
+    free(path);
+    return strsave(rel_vsn);
+}
+
+int main(int argc, char **argv)
+{
+    const char *out_path = NULL;
+    char *release_dir, *emulator, *rel_vsn, *path;
+    char release_path[MAXPATHLEN];
+    args_t in = {0}, emu = {0}, init = {0};
+    struct stat st;
+    int i;
+
+    for (i = 1; i < argc && argv[i][0] == '-'; i++) {
+        if (strcmp(argv[i], "-o") == 0 && i + 1 < argc) {
+            out_path = argv[++i];
+        } else if (strcmp(argv[i], "--") == 0) {
+            i++;
+            break;
+        } else {
+            usage();
+        }
+    }
+    if (i >= argc)
+        usage();
+    release_dir = argv[i++];
+
+    emulator = join(bindir(argv[0]), EMULATOR);
+    if (stat(emulator, &st) != 0)
+        error("cannot find the emulator %s", emulator);
+
+    if (realpath(release_dir, release_path) == NULL)
+        error("%s: %s", release_dir, strerror(errno));
+    if (out_path == NULL) {
+        char *base = strrchr(release_path, '/');
+        out_path = strsave(base != NULL && base[1] != '\0' ? base + 1
+                                                            : release_path);
+    }
+    rel_vsn = release_version(release_path);
+
+    path = emalloc(strlen(release_path) + strlen(rel_vsn) + 32);
+    sprintf(path, "%s/releases/%s/vm.args", release_path, rel_vsn);
+    if (stat(path, &st) == 0)
+        read_args_file(path, &in);
+    for (; i < argc; i++)
+        args_add(&in, argv[i]);
+    split_args(&in, &emu, &init);
+
+    args_add(&init, "-root");
+    args_add(&init, "$ROOT");
+    args_add(&init, "-bindir");
+    args_add(&init, "$ROOT/bin");
+    args_add(&init, "-progname");
+    args_add(&init, "$ROOT");
+    args_add(&init, "-primary_archive");
+    args_add(&init, "$ROOT");
+    args_add(&init, "-boot");
+    sprintf(path, "$ROOT/releases/%s/start", rel_vsn);
+    args_add(&init, strsave(path));
+    sprintf(path, "%s/releases/%s/sys.config", release_path, rel_vsn);
+    if (stat(path, &st) == 0) {
+        args_add(&init, "-config");
+        sprintf(path, "$ROOT/releases/%s/sys", rel_vsn);
+        args_add(&init, strsave(path));
+    }
+
+    crc_init();
+    for (i = 0; release_dirs[i] != NULL; i++) {
+        char *dir = join(release_path, release_dirs[i]);
+        if (stat(dir, &st) != 0 || !S_ISDIR(st.st_mode))
+            error("%s is not a release: no %s directory", release_path,
+                  release_dirs[i]);
+        collect(dir, release_dirs[i]);
+        free(dir);
+    }
+    if (n_entries > 0xffff)
+        error("too many files in the release");
+
+    write_executable(out_path, emulator, &emu, &init);
+    return 0;
+}
