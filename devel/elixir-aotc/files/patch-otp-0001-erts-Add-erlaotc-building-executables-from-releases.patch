+
+absolute_parent() {
+    DIR=$(dirname "${1}");
+    (cd "$DIR" && pwd -P || echo "/");
+}
+
+find_rootdir() {
+    CANDIDATE="${1}";
+    while
+        CANDIDATE=$(absolute_parent "$CANDIDATE");
+        [ "$CANDIDATE" != "/" ] && [ ! -d "$CANDIDATE/erts-%VSN%" ];
+    do :; done;
+
+    if [ "$CANDIDATE" != "/" ]
+    then
+        # It is likely that the files have been copied or moved
+        echo "$CANDIDATE";
+    else
+        echo "${2}";
+    fi
+}
+
+if [ -z "$ERL_ROOTDIR" ]
+then
+    ROOTDIR=$(find_rootdir "$0" "%FINAL_ROOTDIR%")
+else
+    ROOTDIR="$ERL_ROOTDIR"
+fi
+
+BINDIR="$ROOTDIR/erts-%VSN%/bin"
+export BINDIR
+exec "$BINDIR/erlaotc" ${1+"$@"}
