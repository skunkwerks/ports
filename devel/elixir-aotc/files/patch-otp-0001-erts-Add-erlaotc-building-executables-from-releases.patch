diff --git a/erts/etc/common/erlaotc.c b/erts/etc/common/erlaotc.c
new file mode 100644
index 0000000000..0f8f5e69a2
--- /dev/null
+++ b/erts/etc/common/erlaotc.c
@@ -0,0 +1,573 @@
+/*
