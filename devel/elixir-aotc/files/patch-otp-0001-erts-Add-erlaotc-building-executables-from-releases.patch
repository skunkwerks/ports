diff --git a/erts/emulator/beam/erl_aot.c b/erts/emulator/beam/erl_aot.c
new file mode 100644
index 0000000000..ac7fb592c9
--- /dev/null
+++ b/erts/emulator/beam/erl_aot.c
@@ -0,0 +1,289 @@
+/*
+ * %CopyrightBegin%
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Copyright Ericsson AB 2026. All Rights Reserved.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ * %CopyrightEnd%
+ */
+
+/* Executables built by erlaotc: the emulator followed by a zip archive whose
+ * comment holds the arguments ("erlaotc <vsn>\n" then one per line, $ROOT
+ * being the executable). */
+
+#ifdef HAVE_CONFIG_H
+#  include "config.h"
+#endif
+
+#include "sys.h"
+#include "erl_aot.h"
+#include "erl_version.h"
+
+#ifndef __WIN32__
+
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <errno.h>
+#include <limits.h>
+#ifdef __APPLE__
+#  include <mach-o/dyld.h>
+#endif
+
+#define MAGIC "erlaotc " ERLANG_VERSION "\n"
+#define ROOT_VAR "$ROOT"
+
+#define EOCD_SIZE 22
+#define EOCD_SIGNATURE 0x06054b50
+#define MAX_COMMENT_SIZE 65535
+
+static char exe_path[PATH_MAX];
+static int have_exe = 0;
+
+const char *erts_aot_exe_path(void)
+{
+    return have_exe ? exe_path : NULL;
+}
+
+const char *erts_aot_helper_marker(const char *program)
+{
+    static const char *helpers[][2] = {
+        {"inet_gethost", "-erlaot:inet_gethost"},
+        {"epmd", "-erlaot:epmd"},
+        {NULL, NULL}
+    };
+    size_t len = strlen(exe_path);
+    int i;
+
+    if (!have_exe || strncmp(program, exe_path, len) != 0 ||
+        strncmp(program + len, "/bin/", 5) != 0) {
+        return NULL;
+    }
+    program += len + 5;
+    for (i = 0; helpers[i][0] != NULL; i++) {
+        if (strcmp(program, helpers[i][0]) == 0)
+            return helpers[i][1];
+    }
+    return NULL;
+}
+
+static void fatal(const char *what, const char *arg)
+{
+    fprintf(stderr, "%s: %s: %s\n", exe_path, what, arg);
+    exit(1);
+}
+
+static void *xmalloc(size_t size)
+{
+    void *p = malloc(size);
+    if (p == NULL)
+        fatal("cannot allocate memory", "");
+    return p;
+}
+
+static int resolve_self_path(const char *argv0)
+{
+#if defined(__APPLE__)
+    char tmp[PATH_MAX];
+    uint32_t size = sizeof(tmp);
+    (void)argv0;
+    return _NSGetExecutablePath(tmp, &size) == 0 &&
+           realpath(tmp, exe_path) != NULL;
+#elif defined(__linux__)
+    ssize_t n = readlink("/proc/self/exe", exe_path, sizeof(exe_path) - 1);
+    (void)argv0;
+    if (n <= 0)
+        return 0;
+    exe_path[n] = '\0';
+    return 1;
+#else
+    return argv0 != NULL && strchr(argv0, '/') != NULL &&
+           realpath(argv0, exe_path) != NULL;
+#endif
+}
+
+static Uint32 get_le32(const unsigned char *p)
+{
+    return (Uint32)p[0] | ((Uint32)p[1] << 8) | ((Uint32)p[2] << 16) |
+           ((Uint32)p[3] << 24);
+}
+
+static char *read_comment(int fd, off_t file_size)
+{
+    unsigned char *tail;
+    size_t tail_size, i;
+    char *comment = NULL;
+
+    tail_size = MAX_COMMENT_SIZE + EOCD_SIZE;
+    if ((off_t)tail_size > file_size)
+        tail_size = (size_t)file_size;
+    if (tail_size < EOCD_SIZE)
+        return NULL;
+    tail = xmalloc(tail_size);
+    if (pread(fd, tail, tail_size, file_size - (off_t)tail_size) !=
+        (ssize_t)tail_size) {
+        free(tail);
+        return NULL;
+    }
+
+    for (i = tail_size - EOCD_SIZE + 1; i-- > 0; ) {
+        if (get_le32(tail + i) == EOCD_SIGNATURE &&
+            tail[i + 20] + (tail[i + 21] << 8) ==
+            (int)(tail_size - i - EOCD_SIZE)) {
+            size_t len = tail_size - i - EOCD_SIZE;
+            comment = xmalloc(len + 1);
+            memcpy(comment, tail + i + EOCD_SIZE, len);
+            comment[len] = '\0';
+            break;
+        }
+    }
+    free(tail);
+    return comment;
+}
+
+static char *expand_arg(const char *arg)
+{
+    if (strncmp(arg, ROOT_VAR, strlen(ROOT_VAR)) == 0) {
+        const char *rest = arg + strlen(ROOT_VAR);
+        char *res = xmalloc(strlen(exe_path) + strlen(rest) + 1);
+        strcpy(res, exe_path);
+        strcat(res, rest);
+        return res;
+    }
+    return (char *)arg;
+}
+
+/* As erl(1) does */
+static void maybe_start_epmd(int argc, char **argv)
+{
+    int distributed = 0, start_epmd = 1, i;
+    pid_t pid;
+    int status;
+
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-sname") == 0 || strcmp(argv[i], "-name") == 0)
+            distributed = 1;
+        else if (strcmp(argv[i], "-start_epmd") == 0 && i + 1 < argc)
+            start_epmd = strcmp(argv[i + 1], "false") != 0;
+        else if (strcmp(argv[i], "-extra") == 0)
+            break;
+    }
+    if (!distributed || !start_epmd)
+        return;
+
+    pid = fork();
+    if (pid < 0)
+        fatal("cannot start epmd", strerror(errno));
+    if (pid == 0) {
+        execl(exe_path, exe_path, "-erlaot:epmd", "-daemon", (char *)NULL);
+        _exit(127);
+    }
+    while (waitpid(pid, &status, 0) < 0) {
+        if (errno != EINTR)
+            fatal("cannot start epmd", strerror(errno));
+    }
+    if (!WIFEXITED(status) || WEXITSTATUS(status) != 0)
+        fatal("cannot start epmd", "epmd failed");
+}
+
+void erts_aot_early_args(int *argc, char ***argv)
+{
+    struct stat st;
+    int fd, n, i;
+    char *comment, *line, *next;
+    char **args;
+    const char *env;
+
+    if (*argc < 1 || !resolve_self_path((*argv)[0]))
+        return;
+    fd = open(exe_path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return;
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode)) {
+        close(fd);
+        return;
+    }
+    comment = read_comment(fd, st.st_size);
+    close(fd);
+    if (comment == NULL)
+        return;
+    if (strncmp(comment, "erlaotc ", 8) != 0) {
+        free(comment);
+        return;
+    }
+    if (strncmp(comment, MAGIC, strlen(MAGIC)) != 0)
+        fatal("the archive was built for another version of erts", comment);
+    have_exe = 1;
+
+    n = 0;
+    for (line = comment; *line != '\0'; line++) {
+        if (*line == '\n')
+            n++;
+    }
+    args = xmalloc(sizeof(char *) * (n + *argc + 8));
+    i = 0;
+    args[i++] = (*argv)[0];
+    for (line = comment + strlen(MAGIC); *line != '\0'; line = next) {
+        next = strchr(line, '\n');
+        if (next == NULL)
+            fatal("corrupt archive comment", line);
+        *next++ = '\0';
+        args[i++] = expand_arg(line);
+    }
+
+    /* As erl(1) */
+    env = getenv("HOME");
+    if (env != NULL && env[0] != '\0') {
+        args[i++] = "-home";
+        args[i++] = (char *)env;
+    }
+    env = getenv("ERL_EPMD_PORT");
+    if (env != NULL && env[0] != '\0') {
+        args[i++] = "-epmd_port";
+        args[i++] = (char *)env;
+    }
+
+    args[i++] = "-extra";
+    memcpy(args + i, *argv + 1, sizeof(char *) * (*argc - 1));
+    i += *argc - 1;
+    args[i] = NULL;
+
+    *argc = i;
+    *argv = args;
+    maybe_start_epmd(*argc, *argv);
+}
+
+#else /* __WIN32__ */
+
+void erts_aot_early_args(int *argc, char ***argv)
+{
+    (void)argc;
+    (void)argv;
+}
+
+const char *erts_aot_exe_path(void)
+{
+    return NULL;
+}
+
+const char *erts_aot_helper_marker(const char *program)
+{
+    (void)program;
+    return NULL;
+}
+
+#endif
